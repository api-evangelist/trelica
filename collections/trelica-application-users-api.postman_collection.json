      "name": "Application Users",
      "description": {
        "content": "Manage users associated with specific applications",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "daf2210c-49a7-4652-acf3-268b424ebdba",
          "name": "List Application Users",
          "request": {
            "name": "List Application Users",
            "description": {
              "content": "Returns a paginated list of users associated with a specific application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apps",
                "v1",
                ":appId",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Free-text search across user ID, email, and name"
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Filter users modified after this date/time"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Pagination cursor for next page of results"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results to return (default 100)"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "SCIM-style filter expression"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "appId",
                  "description": "(Required) Unique identifier for the application"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "Apps.Read Apps.Users.Read People.Read People.Write Contracts.Read Workflows.Read Assets.Read AuditLog.Read Users.Read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://app.trelica.com/connect/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
