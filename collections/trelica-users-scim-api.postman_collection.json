    "_postman_id": "533f2880-7a05-44dd-8cfd-8b3c3c3ac1c6",
    "name": "Trelica REST Users (SCIM) API",
    "description": "The Trelica REST API provides programmatic access to the core areas of the Trelica SaaS management platform, including applications, people, contracts, workflows, assets, audit logs, and user management via SCIM. The API uses OAuth 2.0 with either Client Credentials (for integrations) or Authorization Code flow (for third-party developer apps). Trelica is now part of 1Password SaaS Manager.\n\nContact Support:\n Name: Trelica Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
